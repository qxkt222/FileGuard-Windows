<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FileGuard</AssemblyName>
    <RootNamespace>FileGuard.App</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 与 WPF 同程序集时，去掉 SDK 自动加的全局 using，避免类型冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileGuard.Core\FileGuard.Core.csproj" />
  </ItemGroup>

  <!-- 窗口和托盘图标从 WPF 资源里读，不依赖 exe 的原生图标资源 -->
  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\tray-on.ico" />
    <Resource Include="Resources\tray-off.ico" />
  </ItemGroup>

  <!-- WinFsp 的 winfsp-msil.dll 是混合模式程序集，Fsp.Interop.Api 的静态构造
       靠 Assembly.Location 定位原生 winfsp-x64.dll。打进单文件 bundle 后
       Location 是空串，挂载会抛 TypeInitializationException。
       元数据加在 FileGuard.WinFsp 的 Reference 上不会传递过来，所以在发布环节改：
       一是强制它作为独立文件复制，二是把它踢出 bundle。 -->
  <ItemGroup>
    <None Include="C:\Program Files (x86)\WinFsp\bin\winfsp-msil.dll"
          Link="winfsp-msil.dll"
          Visible="false"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="KeepWinFspMsilOutOfSingleFileBundle"
          BeforeTargets="_ComputeFilesToBundle;GenerateSingleFileBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'winfsp-msil'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
